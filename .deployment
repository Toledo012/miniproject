; =============================================================================
; .deployment — Configuración inicial para Azure App Service (Linux · PHP 8.2)
; -----------------------------------------------------------------------------
; Este archivo lo lee Kudu/Oryx durante el despliegue desde Git/GitHub Actions
; hacia Azure App Service. Define los hooks de build, las optimizaciones de
; producción para Laravel y señala la raíz pública (public/) como document
; root de la aplicación.
;
; Notas:
;   · En App Service Linux, el código se publica en /home/site/wwwroot.
;   · El document root del servidor (nginx/Apache) debe apuntar a
;     /home/site/wwwroot/public para que Laravel funcione correctamente.
;     Esto se complementa con el "Startup Command" del App Service
;     (App Service → Configuration → General settings → Startup Command).
;   · Las claves SCM_*, POST_BUILD_COMMAND, etc. también pueden definirse
;     como App Settings en el portal; este archivo las versiona en repo.
; =============================================================================

[config]

; --- Build automático en cada despliegue (Kudu) ---
SCM_DO_BUILD_DURING_DEPLOYMENT = true

; --- Usar sistema de build Oryx (estándar en App Service Linux) ---
ENABLE_ORYX_BUILD = true

; --- Raíz pública de Laravel (document root lógico) ---
; Indica a Oryx y al runtime cuál es la carpeta servida públicamente.
APP_PUBLIC_PATH       = public
PROJECT               = public
WEBSITES_PORT         = 80
WEBSITE_DOCUMENT_ROOT = /home/site/wwwroot/public

; --- Optimización: Composer en modo producción ---
COMPOSER_NO_DEV          = 1
COMPOSER_PROCESS_TIMEOUT = 600

; --- Optimización: cache de Laravel para entornos productivos ---
APP_ENV   = production
APP_DEBUG = false
LOG_LEVEL = warning

; --- Pre-build: preparar .env si no existe (Azure inyecta variables vía App Settings) ---
PRE_BUILD_COMMAND = test -f .env || cp .env.example .env

; --- Post-build: cachear configuración, rutas y vistas + enlace de storage ---
POST_BUILD_COMMAND = php artisan config:cache && php artisan route:cache && php artisan view:cache && php artisan storage:link
